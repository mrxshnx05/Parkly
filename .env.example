# Server
NODE_ENV=development
PORT=8787
PARKLY_DATA_PATH=data/parkly-store.json
PARKLY_CORS_ORIGINS=http://localhost:8787,http://127.0.0.1:8787

# Use a long, random value before any production deployment.
PARKLY_JWT_SECRET=replace-this-with-a-32-character-minimum-secret

# Optional no-cost local AI integration. Install and run Ollama locally to enable it.
PARKLY_AI_PROVIDER=auto
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional provider integrations. Leave blank to use safe local/demo adapters.
MAPS_PROVIDER_KEY=
PAYMENTS_WEBHOOK_SECRET=
NOTIFICATIONS_WEBHOOK_URL=
